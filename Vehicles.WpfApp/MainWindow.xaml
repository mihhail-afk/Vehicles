<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles Management" Height="500" Width="700">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Add New Vehicle" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="NameInput" Width="150" Margin="0,0,10,0" VerticalAlignment="Center"/>

                <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="TypeComboBox" Width="130" Margin="0,0,10,0" VerticalAlignment="Center">
                    <ComboBoxItem Content="Car" IsSelected="True"/>
                    <ComboBoxItem Content="Boat"/>
                    <ComboBoxItem Content="AmphibiousCar"/>
                </ComboBox>

                <Button Content="Add Vehicle" Click="AddVehicle_Click" Padding="10,5"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Vehicles" Grid.Column="0" Margin="0,0,5,0">
                <ListBox x:Name="VehiclesListBox"/>
            </GroupBox>

            <GroupBox Header="Action Log" Grid.Column="1" Margin="5,0,0,0">
                <TextBox x:Name="LogTextBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
            <Button Content="Move (10)" Click="Move10_Click" Padding="15,5" Margin="5,0,0,0"/>
            <Button Content="Clear Log" Click="ClearLog_Click" Padding="15,5" Margin="5,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>