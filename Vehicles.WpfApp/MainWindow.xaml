<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles Garage Manager" Height="500" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            <TextBlock Text="Cars Garage" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <TextBox Text="{Binding CarNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
            <Button Content="Add Car" Click="AddCar_Click" Margin="0,0,0,5"/>
            <Button Content="Remove Car" Click="RemoveCar_Click" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Cars}" SelectedItem="{Binding SelectedCar}" Height="250"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Text="Boats Garage" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <TextBox Text="{Binding BoatNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
            <Button Content="Add Boat" Click="AddBoat_Click" Margin="0,0,0,5"/>
            <Button Content="Remove Boat" Click="RemoveBoat_Click" Margin="0,0,0,10"/>
            <ListBox ItemsSource="{Binding Boats}" SelectedItem="{Binding SelectedBoat}" Height="250"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="5">
            <TextBlock Text="Event Log" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <ListBox ItemsSource="{Binding LogEntries}" Height="325"/>
        </StackPanel>
    </Grid>
</Window>